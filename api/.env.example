CATALOG_STORE_DRIVER=mongodb
CATALOG_SEARCH_DRIVER=mongo-basic
CATALOG_MONGODB_URI=mongodb://127.0.0.1:27017
CATALOG_MONGODB_DB_NAME=arc_catalog
CATALOG_MONGODB_PRODUCTS_COLLECTION=catalog_products
