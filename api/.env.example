PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:4000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app

REDIS_URL=redis://127.0.0.1:6379
CACHE_DRIVER=redis
CACHE_TTL=60s

RATE_LIMIT_DRIVER=redis
RATE_LIMIT_LIMIT=20
RATE_LIMIT_TTL=60s
RATE_LIMIT_BLOCK_DURATION=60s

QUEUE_DRIVER=redis
QUEUE_NAME=default
QUEUE_PREFIX=nest-template
QUEUE_REDIS_URL=redis://127.0.0.1:6379
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF=5s
QUEUE_REMOVE_COMPLETED_AFTER=1d
QUEUE_REMOVE_FAILED_AFTER=7d
QUEUE_WORKER_CONCURRENCY=10

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12

MAIL_DRIVER=logger
MAIL_DEFAULT_FROM_EMAIL=noreply@example.com
MAIL_DEFAULT_FROM_NAME=Nest Template
RESEND_API_KEY=

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_OBJECT_STORAGE_REGION=us-east-1
STORAGE_OBJECT_STORAGE_BUCKET=app-files
STORAGE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STORAGE_OBJECT_STORAGE_SECRET_KEY=minioadmin
STORAGE_OBJECT_STORAGE_FORCE_PATH_STYLE=true
