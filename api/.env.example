BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
OTEL_ENABLED=true
OTEL_SERVICE_NAME=arc-api
OTEL_TRACES_CONSOLE_EXPORTER=false
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
SENTRY_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TEST_TRIGGER_SECRET=
SENTRY_TRACES_SAMPLE_RATE=

# Shared secret for POST /v1/internal/jobs/drain (outbox + reconciliation ticks).
OUTBOX_DRAIN_TRIGGER_SECRET=change-me-drain-secret

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12

MAIL_DRIVER=logger
MAIL_DEFAULT_FROM_EMAIL=noreply@example.com
MAIL_DEFAULT_FROM_NAME=Nest Template
RESEND_API_KEY=

WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_TTL_SECONDS=60

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_OBJECT_STORAGE_REGION=us-east-1
STORAGE_OBJECT_STORAGE_BUCKET=app-files
STORAGE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STORAGE_OBJECT_STORAGE_SECRET_KEY=minioadmin
STORAGE_OBJECT_STORAGE_FORCE_PATH_STYLE=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=
# Stripe Checkout Session lifetime; the Card Order stock hold is derived from it.
# Between 30m and 24h (Stripe expires_at constraint).
CHECKOUT_SESSION_TTL=60m

FX_RATE_SYNC_PROVIDER=disabled
FX_RATE_SYNC_INTERVAL=1h
FX_RATE_SYNC_RUN_ON_STARTUP=false
FX_RATE_SYNC_BASE_CURRENCIES=USD
FX_RATE_SYNC_TARGET_CURRENCIES=

OPEN_EXCHANGE_RATES_APP_ID=
OPEN_EXCHANGE_RATES_BASE_URL=https://openexchangerates.org/api


# Which adapter owns payout destinations. `manual_bank` keeps local development
# and tests working without Stripe; production sets `stripe_connect`.
PAYOUT_PROVIDER=manual_bank

# Stripe rules which countries a Connect payout can reach: from a platform in
# the US, the UK, the EEA, Canada or Switzerland, payouts only reach accounts in
# that same region. PAYOUT_PLATFORM_COUNTRY is the platform's own ISO 3166-1
# alpha-2 country; anything else fails startup. Default US.
PAYOUT_PLATFORM_COUNTRY=US

# Optional narrowing of that region set: the ISO 3166-1 alpha-2 codes a seller
# may pick for payout onboarding. Comma-separated, trimmed, deduped; a malformed
# entry fails startup. It can only narrow Stripe's supported region (the EEA,
# GB, CA, CH and US) — codes outside it are intersected away, never added, and a
# list that leaves none fails startup. Unset offers the whole region.
# PAYOUT_CONNECT_COUNTRIES=US,GB,DE,CA

# Where Stripe sends the seller after hosted onboarding: the return URL after a
# completed flow, the refresh URL when a link expired and must be reissued. Both
# must be absolute; defaults point at the local seller finances page.
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/finances
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/finances

# Where money-event journal entries and Seller Payable credits are booked:
# `order.paid`, `order.delivered` and `order.refunded`. `outbox` (default)
# records the outbox event and lets the finance worker book it; `inline` books
# inside the producer's own transaction, so a booking failure rolls that request
# back and its caller retries. Local development has no finance worker, so keep
# `outbox` there; deployments without a worker set `inline`.
FINANCE_MONEY_EVENT_BOOKING=outbox

# The ISO 4217 currency the platform's own provider balance settles in. A shop
# that settles in another currency is converted into this one at payout time,
# and the provider transfer is denominated in it. Default USD.
PAYOUT_PLATFORM_CURRENCY=USD

# Automatic payouts run only on this platform day (UTC) of each month, and pay
# an opted-in shop at most once per platform month. 1..28.
PAYOUT_AUTO_DAY_OF_MONTH=15

# Local/E2E only: make the automatic run due now and accept shops enabled today.
# Still one scheduled payout per shop per month. Refused in production.
PAYOUT_AUTO_PAYOUT_FORCE=false

# Local/test only: shrink the 1m/5m/15m retry schedule for attempts 2, 3, and 4,
# as three comma-separated millisecond values. Refused in production.
PAYOUT_RETRY_DELAYS_MS=60000,300000,900000

# Local/test only: make the manual_bank payout adapter fail deterministically.
# The first N sends per Payout throw; the counters are in memory, per process.
# The reason is what the recorded payouts.reason says, and the mode is `error`
# (provider exception) or `declined` (message is exactly the reason).
# Refused in production.
PAYOUT_STUB_FAIL_ATTEMPTS=0
PAYOUT_STUB_FAIL_REASON=stub_provider_decline
PAYOUT_STUB_FAIL_MODE=error

# When true, sellers may withdraw manually more than once per platform month.
PAYOUT_MANUAL_WITHDRAWAL_UNLIMITED=false

# Minimum days between two Settlement Currency changes for one shop. Default 90.
SETTLEMENT_CURRENCY_CHANGE_INTERVAL_DAYS=90


OPENAI_API_KEY=
AI_PRODUCT_DESCRIPTION_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRODUCT_DESCRIPTION_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=10000
