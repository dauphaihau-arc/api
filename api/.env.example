CATALOG_MONGODB_SEARCH_COLLECTION=catalog_product_search
STOREFRONT_INDEXED_PRICE_PAIRS=US:USD,EUR,GBP,JPY,AUD,CAD,SGD,KRW,HKD,TWD,VND,CNY;VN:VND,EUR,GBP,JPY,AUD,CAD,SGD,KRW,HKD,TWD,CNY,USD
STOREFRONT_RARE_PRICE_CACHE_TTL_MS=300000

REDIS_URL=redis://127.0.0.1:6379
