PORT=3000
LOG_LEVEL=info
LOG_PRETTY=false
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001
APP_BASE_URL=http://localhost:4000
SELLER_APP_BASE_URL=http://localhost:4001

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_LOG_QUERIES=false
DB_SLOW_QUERY_THRESHOLD_MS=250

CATALOG_STORE_DRIVER=mongodb
CATALOG_SEARCH_DRIVER=atlas
CATALOG_MONGODB_URI=mongodb://127.0.0.1:27017
CATALOG_MONGODB_DB_NAME=arc_catalog
CATALOG_MONGODB_PRODUCTS_COLLECTION=catalog_products
CATALOG_MONGODB_PRICES_COLLECTION=catalog_product_prices
CATALOG_MONGODB_SLUGS_COLLECTION=catalog_product_slugs
CATALOG_MONGODB_SEARCH_COLLECTION=catalog_product_search
STOREFRONT_INDEXED_PRICE_PAIRS=US:EUR,GBP,JPY,AUD,CAD;VN:USD,EUR
STOREFRONT_RARE_PRICE_CACHE_TTL_MS=300000

REDIS_URL=redis://127.0.0.1:6379
CACHE_DRIVER=redis
CACHE_ENABLED=true
CACHE_TTL=60s
USER_CACHE_ENABLED=true
STOREFRONT_PUBLIC_RESPONSE_CACHE_ENABLED=true
STOREFRONT_RARE_PRICE_CACHE_ENABLED=true

RATE_LIMIT_DRIVER=redis
RATE_LIMIT_LIMIT=20
RATE_LIMIT_TTL=60s
RATE_LIMIT_BLOCK_DURATION=60s

QUEUE_DRIVER=redis
QUEUE_NAME=default
QUEUE_PREFIX=arc
QUEUE_REDIS_URL=redis://127.0.0.1:6379
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF=5s
QUEUE_REMOVE_COMPLETED_AFTER=1d
QUEUE_REMOVE_FAILED_AFTER=7d
QUEUE_WORKER_CONCURRENCY=10

INVENTORY_RESERVATION_DRIVER=local
INVENTORY_SERVICE_BASE_URL=http://127.0.0.1:8080

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_DOMAIN_EVENTS_EXCHANGE=arc.domain-events
RABBITMQ_INVENTORY_ORDER_EVENTS_QUEUE=inventory.order-events

BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/ops/queues
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
OTEL_ENABLED=true
OTEL_SERVICE_NAME=arc-api
OTEL_TRACES_CONSOLE_EXPORTER=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
SENTRY_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TEST_TRIGGER_SECRET=
SENTRY_TRACES_SAMPLE_RATE=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

BCRYPT_SALT_ROUNDS=12

MAIL_DRIVER=logger
MAIL_DEFAULT_FROM_EMAIL=noreply@example.com
MAIL_DEFAULT_FROM_NAME=Nest Template
RESEND_API_KEY=

WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_TTL_SECONDS=60

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_OBJECT_STORAGE_REGION=us-east-1
STORAGE_OBJECT_STORAGE_BUCKET=app-files
STORAGE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STORAGE_OBJECT_STORAGE_SECRET_KEY=minioadmin
STORAGE_OBJECT_STORAGE_FORCE_PATH_STYLE=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

FX_RATE_SYNC_PROVIDER=disabled
FX_RATE_SYNC_INTERVAL=1h
FX_RATE_SYNC_RUN_ON_STARTUP=false
FX_RATE_SYNC_BASE_CURRENCIES=USD
FX_RATE_SYNC_TARGET_CURRENCIES=

OPEN_EXCHANGE_RATES_APP_ID=
OPEN_EXCHANGE_RATES_BASE_URL=https://openexchangerates.org/api

OPENAI_API_KEY=
AI_PRODUCT_DESCRIPTION_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRODUCT_DESCRIPTION_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=10000
