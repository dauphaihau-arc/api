{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "moduleNameMapper": {
    "^~/(.*)$": "<rootDir>/src/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "watchman": false,
  "globalSetup": "<rootDir>/test/support/int-global-setup.cjs",
  "globalTeardown": "<rootDir>/test/support/int-global-teardown.cjs",
  "maxWorkers": 2,
  "setupFiles": [
    "<rootDir>/test/support/int-env.setup.ts"
  ]
}
