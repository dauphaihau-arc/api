{
  "name": "nest-template",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": ">=22 <23"
  },
  "volta": {
    "node": "22.0.0",
    "pnpm": "9.3.0"
  },
  "scripts": {
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build && tsc-alias -p tsconfig.build.json",
    "db:migration:create": "mikro-orm migration:create",
    "db:migration:down": "mikro-orm migration:down",
    "db:migration:up": "mikro-orm migration:up",
    "db:seed": "ts-node -r tsconfig-paths/register ./database/seed.ts",
    "format": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/src/index.js",
    "start:worker": "node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --entryFile worker",
    "start:worker:dev": "node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --watch --entryFile worker",
    "start:worker:prod": "node dist/src/worker.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@keyv/redis": "^5.1.6",
    "@mikro-orm/cli": "^6.6.14",
    "@mikro-orm/core": "^6.5.8",
    "@mikro-orm/migrations": "^6.6.14",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.5.8",
    "@nestjs/apollo": "^13.0.3",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.0.3",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.76.6",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "graphql": "^16.11.0",
    "ioredis": "^5.10.1",
    "keyv": "^5.6.0",
    "ms": "^2.1.3",
    "nestjs-cls": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dauphaihau/eslint-config": "^0.3.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.3.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
