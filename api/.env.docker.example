PORT=4000
LOG_LEVEL=info
LOG_PRETTY=false
NODE_ENV=development
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=http://localhost:4001,http://localhost:4002

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_LOG_QUERIES=false
DB_SLOW_QUERY_THRESHOLD_MS=250
STOREFRONT_INDEXED_PRICE_PAIRS=US:USD,EUR,GBP,JPY,AUD,CAD;VN:VND
STOREFRONT_RARE_PRICE_CACHE_TTL_MS=300000

REDIS_URL=redis://redis:6379
CACHE_DRIVER=redis
CACHE_ENABLED=true
CACHE_TTL=60s
CATEGORY_TAXONOMY_CACHE_ENABLED=true
USER_CACHE_ENABLED=true
STOREFRONT_PUBLIC_RESPONSE_CACHE_ENABLED=true
STOREFRONT_RARE_PRICE_CACHE_ENABLED=true

RATE_LIMIT_DRIVER=redis
RATE_LIMIT_LIMIT=20
RATE_LIMIT_TTL=60s
RATE_LIMIT_BLOCK_DURATION=60s

QUEUE_DRIVER=redis
QUEUE_NAME=default
QUEUE_PREFIX=arc
QUEUE_REDIS_URL=redis://redis:6379
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF=5s
QUEUE_REMOVE_COMPLETED_AFTER=1d
QUEUE_REMOVE_FAILED_AFTER=7d
QUEUE_WORKER_CONCURRENCY=10

BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/ops/queues

INVENTORY_RESERVATION_DRIVER=remote
INVENTORY_SERVICE_BASE_URL=http://inventory-service:8080
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_DOMAIN_EVENTS_EXCHANGE=arc.domain-events
RABBITMQ_INVENTORY_ORDER_EVENTS_QUEUE=inventory.order-events

OTEL_ENABLED=true
OTEL_SERVICE_NAME=arc-api
OTEL_TRACES_CONSOLE_EXPORTER=false
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=development

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# Encrypts values that must never be readable at rest. Exactly 32 bytes, as 64
# hex characters or base64. Generate one per environment; the service refuses to
# start without it.
FIELD_ENCRYPTION_KEY=

BCRYPT_SALT_ROUNDS=12

MAIL_DRIVER=logger
MAIL_DEFAULT_FROM_EMAIL=noreply@example.com
MAIL_DEFAULT_FROM_NAME=Nest Template

WEB_PUSH_TTL_SECONDS=60

STORAGE_DRIVER=minio
STORAGE_OBJECT_STORAGE_ENDPOINT=http://minio:9000
STORAGE_OBJECT_STORAGE_REGION=us-east-1
STORAGE_OBJECT_STORAGE_BUCKET=app-files
STORAGE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STORAGE_OBJECT_STORAGE_SECRET_KEY=minioadmin
STORAGE_OBJECT_STORAGE_FORCE_PATH_STYLE=true

FX_RATE_SYNC_PROVIDER=disabled
FX_RATE_SYNC_INTERVAL=1h
FX_RATE_SYNC_RUN_ON_STARTUP=false
OPEN_EXCHANGE_RATES_BASE_URL=https://openexchangerates.org/api

# Automatic payouts run only on this platform day (UTC) of each month, and pay
# an opted-in shop at most once per platform month. 1..28.
PAYOUT_AUTO_DAY_OF_MONTH=15
# Local/E2E only: make the automatic run due now and accept shops enabled today.
# Still one scheduled payout per shop per month. Refused in production.
PAYOUT_AUTO_PAYOUT_FORCE=false
# When true, sellers may withdraw manually more than once per platform month.
PAYOUT_MANUAL_WITHDRAWAL_UNLIMITED=false
