base_url=http://127.0.0.1:4000
auth_login_email=member@example.com
auth_login_password=Password123!

seller_login_email=maker.olive@example.com
seller_login_password=Password123!

# Dedicated buyer for the paid card Order flow. Registering twice is not an
# error, so the flow can re-use this account.
buyer_login_email=paid-card-order-buyer@example.com
buyer_login_password=Password123!

# Paste the Stripe Checkout Session id (cs_...) printed by
# checkout/create-card-order.manual.hurl before running
# finance/settle-paid-card-order.manual.hurl.
checkout_session_id=

# Carrier webhook tests. The API must be started with this value:
#   CARRIER_WEBHOOK_SECRET=carrier-webhook-test-secret
# The signatures are precomputed over the exact body files in
# `webhooks/carrier/bodies/`; regenerate them with
# `just carrier sign <body file>` after editing a body.
carrier_webhook_test_secret=carrier-webhook-test-secret
carrier_signature_unknown_tracking=550534ab6defcd69e676398e5893bcdcb5f7c04a847cd7d167e036c90788e097
carrier_signature_unsupported_code=d9483ef4255e06895aae6cfb0b0973a19d130f810fbb4b87bb31402e54e15fda
