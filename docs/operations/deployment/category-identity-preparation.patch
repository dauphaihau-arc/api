+import { Controller, Get, Header } from '@nestjs/common';
+import { ApiOkResponse, ApiOperation, ApiTags } from '@nestjs/swagger';
+
+/**
+ * Additive preparation endpoint for the category public-identity cutover.
+ *
+ * Deploy this on the still-internal-identity API (generation `1`) so prepared
+ * clients can probe the running generation and detect the later public
+ * activation. It changes no existing identifier semantics.
+ */
+@Controller('categories')
+@ApiTags('Categories')
+export class CategoryIdentityContractController {
+  @Get('contract')
+  @Header('Cache-Control', 'private, no-cache')
+  @ApiOperation({ summary: 'Get the category identity contract generation' })
+  @ApiOkResponse({ description: 'Category identity contract generation.' })
+  categoryIdentityContract(): { version: string } {
+    return { version: '1' };
+  }
+}
